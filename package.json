{
  "displayName": "Homebridge TTLock Access Code",
  "name": "homebridge-ttlock-accesscode",
  "version": "1.0.1",
  "description": "Plugin that uses TTLock Cloud API to communicate with TTLock Devices connected to the G2 Gateway.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeliardM/homebridge-ttlock-accesscode.git"
  },
  "bugs": {
    "url": "https://github.com/ZeliardM/homebridge-ttlock-accesscode/issues"
  },
  "engines": {
    "homebridge": "^1.11 || ^2.0",
    "node": "^20 || ^22 || ^24"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "npm ci && rimraf -I ./dist && npm run lint && tsc",
    "lint": "eslint src/**/*.ts --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "keywords": [
    "access code",
    "accesscode",
    "homebridge-plugin",
    "ttlock",
    "smart-lock"
  ],
  "files": [
    "config.schema.json",
    "dist",
    "LICENSE"
  ],
  "homepage": "https://github.com/ZeliardM/homebridge-ttlock-accesscode#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ZeliardM"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/ZeliardM/USD"
    }
  ],
  "dependencies": {
    "async-mutex": "^0.5.0",
    "axios": "^1.11.0",
    "ber-tlv": "^0.9.2",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.3.0",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "homebridge": "^2.0.0-beta.29",
    "node-persist": "^4.0.4",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "overrides": {
    "node-persist": "^4.0.4"
  }
}
