{
  "displayName": "Homebridge TTLock Access Code",
  "name": "homebridge-ttlock-accesscode",
  "version": "2.4.0-beta.1",
  "description": "Plugin that uses TTLock Cloud API to communicate with TTLock Devices connected to the G2 Gateway.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeliardM/homebridge-ttlock-accesscode.git"
  },
  "bugs": {
    "url": "https://github.com/ZeliardM/homebridge-ttlock-accesscode/issues"
  },
  "engines": {
    "homebridge": "^1.11.2 || ^2.0.0",
    "node": "^22 || ^24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf -I ./dist && tsc",
    "lint": "eslint src/**/*.ts homebridge-ui/**/*.js --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "echo \"No test specified\" && exit 0",
    "watch": "npm run build && npm link && nodemon"
  },
  "keywords": [
    "access code",
    "accesscode",
    "homebridge",
    "homebridge-plugin",
    "homebridge-ttlock",
    "homebridge-ttlock-accesscode",
    "smarthome",
    "smart home",
    "smart lock",
    "smart-lock",
    "ttlock",
    "ttlock-accesscode"
  ],
  "files": [
    "config.schema.json",
    "dist",
    "homebridge-ui",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.8.1",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "homepage": "https://github.com/ZeliardM/homebridge-ttlock-accesscode#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ZeliardM"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/ZeliardM/USD"
    }
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "axios": "^1.19.0",
    "ber-tlv": "^0.9.2",
    "dirigera": "^1.8.1"
  },
  "overrides": {
    "node-persist": "^4.0.4"
  }
}
